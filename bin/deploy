#!/bin/sh
# Build signed on the Mac inside a Rex session (SSH can't reach the login keychain), install and launch.
# Usage: bin/deploy [ipad|iphone]
set -e
. "$(dirname "$0")/config"
case "${1:-ipad}" in
  iphone) DEVICE=$IPHONE ;;
  *) DEVICE=$IPAD ;;
esac
rsync -a --delete --exclude .git --exclude vendor --exclude build --exclude '*.xcodeproj' --exclude Info.plist --exclude bin/config "$(dirname "$0")/../" "$MAC:Projects/irex/"
ssh -o BatchMode=yes $MAC 'rm -f /tmp/irex-build.log; export PATH=/opt/homebrew/bin:$PATH; cd Projects/irex && xcodegen -q' 2>/dev/null
MAC_HOME=$(ssh -o BatchMode=yes "$MAC" 'echo $HOME')
rex -S "$REX_HOST" new irex-build -c "$MAC_HOME/Projects/irex" -- sh -c "export PATH=/opt/homebrew/bin:\$PATH; xcodebuild -scheme Irex -destination generic/platform=iOS -derivedDataPath build -allowProvisioningUpdates DEVELOPMENT_TEAM=$TEAM -quiet build > /tmp/irex-build.log 2>&1; echo \"exit=\$?\" >> /tmp/irex-build.log" >/dev/null
until ssh -o BatchMode=yes $MAC 'grep -q ^exit= /tmp/irex-build.log' 2>/dev/null; do sleep 3; done
ssh -o BatchMode=yes $MAC "grep -E 'error|exit=' /tmp/irex-build.log; grep -q '^exit=0' /tmp/irex-build.log && \
  xcrun devicectl device install app --device $DEVICE Projects/irex/build/Build/Products/Debug-iphoneos/Irex.app >/dev/null && \
  xcrun devicectl device process launch --terminate-existing --device $DEVICE io.github.unayung.Irex 2>&1 | tail -1" 2>&1 | grep -v 'Install \(Started\|Failed\)'
