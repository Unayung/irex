#!/bin/sh
# Sync this tree to the Mac and build there. Usage: bin/build [device|sim]
set -e
. "$(dirname "$0")/config"
DEST=Projects/irex
rsync -a --delete --exclude .git --exclude vendor --exclude build --exclude '*.xcodeproj' --exclude Info.plist --exclude bin/config "$(dirname "$0")/../" "$MAC:$DEST/"
ssh -o BatchMode=yes "$MAC" "export PATH=/opt/homebrew/bin:\$PATH; cd $DEST && mkdir -p vendor && rsync -a ~/build/ghostty/zig-out/lib/ghostty-vt.xcframework vendor/ && xcodegen -q && \
  if [ \"${1:-device}\" = sim ]; then xcodebuild -scheme Irex -destination 'generic/platform=iOS Simulator' -derivedDataPath build -quiet build; \
  else xcodebuild -scheme Irex -destination 'generic/platform=iOS' -derivedDataPath build -allowProvisioningUpdates DEVELOPMENT_TEAM=$TEAM -quiet build; fi" 2>&1 | grep -v 'Install \(Started\|Failed\)'
