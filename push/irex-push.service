# systemd user unit: cp to ~/.config/systemd/user/, then systemctl --user enable --now irex-push
[Unit]
Description=irex-push: Apple Push for Rex agents (notifications and the Live Activity)
After=network-online.target

[Service]
# IREX_KEY_ID, IREX_TEAM_ID, IREX_KEY_FILE, IREX_TOPIC (see main.go)
EnvironmentFile=%h/.config/irex-push/env
ExecStart=%h/.local/bin/irex-push
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
